universe   = vanilla
executable = /user/dgeeraer/MURAVES/Simulation_Studies/PUMAS-and-TURTLE/Mulder/HTCondor/run_bin_job.sh
arguments  = $(az_start) $(az_end) $(el) $(job) __CLUSTER_ARG__ __DPHI__ __DEL__ __RHO__ __N_E__ __NEVENTS__ __RUN_TAG__

log    = /user/dgeeraer/MURAVES/output_mulder/output_htcondor/__RUN_TAG__/$(label)_job$(job).log
output = /user/dgeeraer/MURAVES/output_mulder/output_htcondor/__RUN_TAG__/$(label)_job$(job).out
error  = /user/dgeeraer/MURAVES/output_mulder/output_htcondor/__RUN_TAG__/$(label)_job$(job).err

request_cpus     = 1
request_memory   = 1GB
request_disk     = 1GB

should_transfer_files   = NO

max_idle = __MAX_IDLE__

# az_start/az_end/el are LOCAL (pre-PHI_OFFSET) values, same units as
# chunks.txt/bins.txt - run_bin_job.sh applies PHI_OFFSET itself.
# label = az<abs_start>-<abs_end>_el<el> (absolute az), built by
# generate_job_list.sh, used only for readable .log/.out/.err names.

queue az_start,az_end,el,job,label from __JOBS_FILE__



