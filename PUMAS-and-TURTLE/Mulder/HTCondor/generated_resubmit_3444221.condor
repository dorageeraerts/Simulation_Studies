universe   = vanilla
executable = /user/dgeeraer/MURAVES/Simulation_Studies/PUMAS-and-TURTLE/Mulder/HTCondor/run_bin_job.sh
arguments  = $(az_start) $(az_end) $(el) $(job) 3444221 0.2 0.2 3.2E3 10000 100 staging_20260727_104120_resubmit_20260729_115945

log    = /user/dgeeraer/MURAVES/output_mulder/output_htcondor/staging_20260727_104120_resubmit_20260729_115945/$(label)_job$(job).log
output = /user/dgeeraer/MURAVES/output_mulder/output_htcondor/staging_20260727_104120_resubmit_20260729_115945/$(label)_job$(job).out
error  = /user/dgeeraer/MURAVES/output_mulder/output_htcondor/staging_20260727_104120_resubmit_20260729_115945/$(label)_job$(job).err

request_cpus     = 1
request_memory   = 1GB
request_disk     = 1GB

should_transfer_files   = NO

max_idle = 1000

# az_start/az_end/el are LOCAL (pre-PHI_OFFSET) values, same units as
# chunks.txt/bins.txt - run_bin_job.sh applies PHI_OFFSET itself.
# label = az<abs_start>-<abs_end>_el<el> (absolute az), built by
# generate_job_list.sh, used only for readable .log/.out/.err names.

queue az_start,az_end,el,job,label from missing_jobs_3444221.txt



